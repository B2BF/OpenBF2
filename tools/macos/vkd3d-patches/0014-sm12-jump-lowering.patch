+/* BF2 macOS port: the components a store writes, as (start, writemask) in component indices of
+ * its variable; false for a non-constant (relative) path. */
+static bool flatten_store_components(struct hlsl_ctx *ctx, const struct hlsl_ir_store *store,
+        unsigned int *start, uint32_t *writemask)
+{
+    unsigned int count;
+
+    if (!hlsl_component_index_range_from_deref(ctx, &store->lhs, start, &count) || count >= 32)
+        return false;
+    *writemask = store->writemask;
+    if (!hlsl_is_numeric_type(store->rhs.node->data_type) || !*writemask)
+        *writemask = (1u << count) - 1;
+    return true;
 }
 
+static bool flatten_stores_overlap(struct hlsl_ctx *ctx, const struct hlsl_ir_store *store,
+        const struct hlsl_ir_store *target, unsigned int target_start, uint32_t target_mask)
+{
+    unsigned int start, i, j;
+    uint32_t mask;
+
+    if (store->lhs.var != target->lhs.var)
+        return false;
+    if (!flatten_store_components(ctx, store, &start, &mask))
+        return true;
+    for (i = 0; i < 32; ++i)
+    {
+        if (!(mask & (1u << i)))
+            continue;
+        for (j = 0; j < 4; ++j)
+        {
+            if ((target_mask & (1u << j)) && start + i == target_start + j)
+                return true;
+        }
+    }
+    return false;
+}
+
+/* BF2 macOS port: whether a store to an overlapping component of target's variable may execute
+ * before target: any such store earlier in program order, or anywhere in a loop around target
+ * (a later store in the loop body reaches the next iteration). With target NULL (or not in the
+ * block): whether the block holds any such store. *found is set once target is reached. */
+static bool flatten_may_be_written_before(struct hlsl_ctx *ctx, const struct hlsl_block *block,
+        const struct hlsl_ir_store *target, unsigned int target_start, uint32_t target_mask, bool *found)
+{
+    struct hlsl_ir_node *instr;
+    bool written = false;
+
+    LIST_FOR_EACH_ENTRY(instr, &block->instrs, struct hlsl_ir_node, entry)
+    {
+        if (instr == &target->node)
+        {
+            *found = true;
+            return written;
+        }
+
+        switch (instr->type)
+        {
+            case HLSL_IR_STORE:
+                if (flatten_stores_overlap(ctx, hlsl_ir_store(instr), target, target_start, target_mask))
+                    written = true;
+                break;
+
+            case HLSL_IR_IF:
+            {
+                struct hlsl_ir_if *iff = hlsl_ir_if(instr);
+
+                written |= flatten_may_be_written_before(ctx, &iff->then_block,
+                        target, target_start, target_mask, found);
+                if (*found)
+                    return written;
+                written |= flatten_may_be_written_before(ctx, &iff->else_block,
+                        target, target_start, target_mask, found);
+                if (*found)
+                    return written;
+                break;
+            }
+
+            case HLSL_IR_LOOP:
+            {
+                struct hlsl_ir_loop *loop = hlsl_ir_loop(instr);
+                bool unused = false;
+
+                written |= flatten_may_be_written_before(ctx, &loop->body,
+                        target, target_start, target_mask, found);
+                if (!*found)
+                    written |= flatten_may_be_written_before(ctx, &loop->iter,
+                            target, target_start, target_mask, found);
+                if (*found)
+                    return written
+                            || flatten_may_be_written_before(ctx, &loop->body, NULL, target_start, target_mask, &unused)
+                            || flatten_may_be_written_before(ctx, &loop->iter, NULL, target_start, target_mask, &unused);
+                break;
+            }
+
+            case HLSL_IR_SWITCH:
+            {
+                struct hlsl_ir_switch *s = hlsl_ir_switch(instr);
+                struct hlsl_ir_switch_case *c;
+
+                LIST_FOR_EACH_ENTRY(c, &s->cases, struct hlsl_ir_switch_case, entry)
+                {
+                    written |= flatten_may_be_written_before(ctx, &c->body,
+                            target, target_start, target_mask, found);
+                    if (*found)
+                        return written;
+                }
+                break;
+            }
+
+            default:
+                break;
+        }
+    }
+    return written;
+}

+/* BF2 macOS port: a flattened store keeps the variable's old value where the condition fails.
+ * Where that old value is undefined (no store to these components can have run before, and the
+ * variable is a local temporary, not a parameter, input, uniform or global), any value is a valid
+ * result, so the store keeps its new value unconditionally. Selecting against the undefined value
+ * instead reads a temporary register before it is written: D3D9's vs_1_1 validator rejects that,
+ * and a NaN in it propagates through the lerp-style select (cond * (a - b) + b). Seen with
+ * per-component stores of a block-local value, e.g. mul()'s result inside a loop unrolled to its
+ * array bound behind a uniform exit (if (...) break; o.t[q] = mul(...)). */
+static bool flatten_store_old_value_undefined(struct hlsl_ctx *ctx, const struct hlsl_block *root,
+        const struct hlsl_ir_store *store)
+{
+    const struct hlsl_ir_var *var = store->lhs.var, *global;
+    unsigned int start;
+    uint32_t mask;
+    bool found = false;
+
+    if (!root || var->is_uniform || var->is_param || var->is_input_semantic || var->is_output_semantic
+            || var->is_tgsm || (var->storage_modifiers & (HLSL_STORAGE_STATIC | HLSL_STORAGE_UNIFORM)))
+        return false;
+    LIST_FOR_EACH_ENTRY(global, &ctx->globals->vars, struct hlsl_ir_var, scope_entry)
+    {
+        if (global == var)
+            return false;
+    }
+    if (!flatten_store_components(ctx, store, &start, &mask) || mask > VKD3DSP_WRITEMASK_ALL)
+        return false;
+    if (flatten_may_be_written_before(ctx, root, store, start, mask, &found))
+        return false;
+    return found;
+}

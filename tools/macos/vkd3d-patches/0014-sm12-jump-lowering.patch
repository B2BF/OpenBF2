+/* BF2 macOS port: whether every component a store writes held the constant 0 before `time`. */
+static bool loop_unrolling_store_overwrites_zero(struct hlsl_ctx *ctx, const struct copy_propagation_state *state,
+        const struct hlsl_ir_store *store, unsigned int time)
+{
+    unsigned int start, count, i, writemask = store->writemask;
 
+    if (!hlsl_component_index_range_from_deref(ctx, &store->lhs, &start, &count))
+        return false;
+    if (!hlsl_is_numeric_type(store->rhs.node->data_type) || !writemask)
+        writemask = (1u << count) - 1;
+    for (i = 0; i < count && i < 32; ++i)
+    {
+        const struct copy_propagation_value *value;
+        const struct hlsl_ir_constant *constant;
+
+        if (!(writemask & (1u << i)))
+            continue;
+        if (!(value = copy_propagation_get_value(state, store->lhs.var, start + i, time)))
+            return false;
+        if (value->node->type != HLSL_IR_CONSTANT)
+            return false;
+        constant = hlsl_ir_constant(value->node);
+        if (constant->value.u[value->component].u)
+            return false;
+    }
+    return true;
+}
+
+static bool loop_unrolling_block_stores_var(const struct hlsl_block *block, const struct hlsl_ir_var *var)
+{
+    struct hlsl_ir_node *instr;
+
+    LIST_FOR_EACH_ENTRY(instr, &block->instrs, struct hlsl_ir_node, entry)
+    {
+        if (instr->type == HLSL_IR_STORE && hlsl_ir_store(instr)->lhs.var == var)
+            return true;
+    }
+    return false;
+}

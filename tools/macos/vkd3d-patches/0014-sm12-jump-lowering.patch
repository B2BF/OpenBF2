+/* Collects (if `remove`: removes) the stores of the loop body to non-synthetic variables in a
+ * block (the loop's iteration statement, e.g. ++q, is not part of it); returns false when one of
+ * them does not overwrite a constant 0 held before `time`. */
+static bool loop_unrolling_zero_stores(struct hlsl_ctx *ctx, const struct copy_propagation_state *state,
+        const struct hlsl_ir_loop *loop, struct hlsl_block *block, unsigned int time, bool remove, unsigned int *count)
+{
+    struct hlsl_ir_node *instr, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(instr, next, &block->instrs, struct hlsl_ir_node, entry)
+    {
+        if (instr->type == HLSL_IR_STORE)
+        {
+            struct hlsl_ir_store *store = hlsl_ir_store(instr);
+
+            if (store->lhs.var->is_synthetic || loop_unrolling_block_stores_var(&loop->iter, store->lhs.var))
+                continue;
+            if (!remove && !loop_unrolling_store_overwrites_zero(ctx, state, store, time))
+                return false;
+            ++*count;
+            if (remove)
+            {
+                list_remove(&instr->entry);
+                hlsl_free_instr(instr);
+            }
+        }
+        else if (instr->type == HLSL_IR_IF)
+        {
+            struct hlsl_ir_if *iff = hlsl_ir_if(instr);
+
+            if (!loop_unrolling_zero_stores(ctx, state, loop, &iff->then_block, time, remove, count)
+                    || !loop_unrolling_zero_stores(ctx, state, loop, &iff->else_block, time, remove, count))
+                return false;
+        }
+        else if (instr->type == HLSL_IR_LOOP || instr->type == HLSL_IR_SWITCH)
+        {
+            return false;
+        }
+    }
+    return true;
+}

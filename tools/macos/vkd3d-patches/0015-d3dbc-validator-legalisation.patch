+static enum vkd3d_result d3dbc_legalise_program(struct vsir_program *program,
+        const struct vkd3d_shader_compile_info *compile_info)
+{
+    const struct vkd3d_shader_version *version = &program->shader_version;
+    const struct vkd3d_shader_hlsl_source_info *hlsl_info;
+    struct d3dbc_legalise l = {.program = program};
+    enum vkd3d_result ret;
+    bool ps_2_b;
+
+    if (version->major > 3)
+        return VKD3D_OK;
+    hlsl_info = vkd3d_find_struct(compile_info->next, HLSL_SOURCE_INFO);
+    ps_2_b = hlsl_info && hlsl_info->profile && !ascii_strcasecmp(hlsl_info->profile, "ps_2_b");
+
+    /* X5326 holds for every version; the encoding rules below are SM1/2 ones. */
+    if ((ret = d3dbc_legalise_uninitialized_reads(&l)) < 0)
+        return ret;
+    if (version->major > 2)
+        return VKD3D_OK;
+    l.scratch_base = program->temp_count;
+    if (version->type == VKD3D_SHADER_TYPE_VERTEX)
+    {
+        if ((ret = d3dbc_legalise_constants(&l)) < 0)
+            goto done;
+    }
+    else if (version->major == 2)
+    {
+        if ((version->minor == 0 || ps_2_b) && (ret = d3dbc_legalise_ps20_swizzles(&l)) < 0)
+            goto done;
+        if ((ret = d3dbc_legalise_ps2_output_writes(&l)) < 0)
+            goto done;
+    }
+    ret = VKD3D_OK;
+done:
+    vkd3d_free(l.live);
+    program->temp_count = l.scratch_base + l.scratch_used;
+    return ret;
+}

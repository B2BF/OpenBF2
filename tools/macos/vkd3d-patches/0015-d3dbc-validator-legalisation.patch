+/* X5406: a non-mov instruction writing oC#/oDepth writes a scratch temp instead, followed by a
+ * mov of the written components. */
+static enum vkd3d_result d3dbc_legalise_ps2_output_writes(struct d3dbc_legalise *l)
+{
+    struct vsir_program_iterator it = vsir_program_iterator(&l->program->instructions);
+    struct vkd3d_shader_instruction *ins;
+    unsigned int inserted = 0;
+    enum vkd3d_result ret;
+
+    if ((ret = d3dbc_legalise_compute_liveness(l)) < 0)
+        return ret;
+    for (ins = vsir_program_iterator_head(&it); ins; ins = vsir_program_iterator_next(&it))
+    {
+        struct vsir_dst_operand out;
+        struct vkd3d_shader_location loc;
+        unsigned int idx;
+
+        if (d3dbc_legalise_skip(ins) || ins->opcode == VSIR_OP_MOV || ins->dst_count != 1
+                || (ins->dst[0].reg.type != VSIR_REGISTER_COLOROUT && ins->dst[0].reg.type != VSIR_REGISTER_DEPTHOUT))
+            continue;
+        out = ins->dst[0];
+        loc = ins->location;
+        d3dbc_legalise_begin(l, ins, it.idx - inserted, true);
+        idx = d3dbc_legalise_scratch(l, 0);
+        d3dbc_legalise_temp_dst(&ins->dst[0], idx, out.write_mask);
+        ins->dst[0].modifiers = out.modifiers;
+        ins->dst[0].shift = out.shift;
+        if (!vsir_program_iterator_insert_after(&it, 1))
+            return VKD3D_ERROR_OUT_OF_MEMORY;
+        ins = vsir_program_iterator_next(&it);
+        ++inserted;
+        if (!vsir_instruction_init_with_params(l->program, ins, &loc, VSIR_OP_MOV, 1, 1))
+            return VKD3D_ERROR_OUT_OF_MEMORY;
+        ins->dst[0] = out;
+        ins->dst[0].modifiers = 0;
+        ins->dst[0].shift = 0;
+        d3dbc_legalise_temp_src(&ins->src[0], idx, VKD3D_SHADER_NO_SWIZZLE);
+    }
+    return VKD3D_OK;
+}

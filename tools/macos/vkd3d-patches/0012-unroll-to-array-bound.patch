+/* BF2 macOS port: true when a deref has a constant index beyond its array/vector/matrix
+ * (the out-of-bounds test of validate_component_index_range, without emitting an error). */
+static bool loop_unrolling_deref_out_of_bounds(struct hlsl_ctx *ctx, const struct hlsl_deref *deref)
+{
+    const struct hlsl_type *type;
+    unsigned int i;
+
+    if (!deref->var)
+        return false;
+    type = deref->var->data_type;
+    for (i = 0; i < deref->path_len; ++i)
+    {
+        struct hlsl_ir_node *path_node = deref->path[i].node;
+
+        if (path_node && path_node->type == HLSL_IR_CONSTANT)
+        {
+            unsigned int idx = hlsl_ir_constant(path_node)->value.u[0].u;
+
+            if ((type->class == HLSL_CLASS_ARRAY && idx >= type->e.array.elements_count)
+                    || (type->class == HLSL_CLASS_VECTOR && idx >= type->e.numeric.dimx)
+                    || (type->class == HLSL_CLASS_MATRIX && idx >= hlsl_type_major_size(type)))
+                return true;
+        }
+        if (!path_node || type->class == HLSL_CLASS_SCALAR)
+            return false;
+        type = hlsl_get_element_type_from_path_index(ctx, type, path_node);
+    }
+    return false;
 }
 
+static bool loop_unrolling_block_out_of_bounds(struct hlsl_ctx *ctx, const struct hlsl_block *block)
+{
+    struct hlsl_ir_node *instr;
+
+    LIST_FOR_EACH_ENTRY(instr, &block->instrs, struct hlsl_ir_node, entry)
+    {
+        switch (instr->type)
+        {
+            case HLSL_IR_LOAD:
+                if (loop_unrolling_deref_out_of_bounds(ctx, &hlsl_ir_load(instr)->src))
+                    return true;
+                break;
+            case HLSL_IR_STORE:
+                if (loop_unrolling_deref_out_of_bounds(ctx, &hlsl_ir_store(instr)->lhs))
+                    return true;
+                break;
+            case HLSL_IR_IF:
+                if (loop_unrolling_block_out_of_bounds(ctx, &hlsl_ir_if(instr)->then_block)
+                        || loop_unrolling_block_out_of_bounds(ctx, &hlsl_ir_if(instr)->else_block))
+                    return true;
+                break;
+            case HLSL_IR_LOOP:
+                if (loop_unrolling_block_out_of_bounds(ctx, &hlsl_ir_loop(instr)->body))
+                    return true;
+                break;
+            default:
+                break;
+        }
+    }
+    return false;
+}
